{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run build)",
      "Bash(bun run format)",
      "Bash(bun run lint)",
      "Bash(bun run lint *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.ts"],
            "timeout": 10,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
