{
  "name": "tss-shadcn",
  "description": "A blank minimal TanStack Start application configured with shadcn/ui and Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && tsc --noEmit && oxlint .",
    "format": "oxfmt .",
    "update": "bun update --interactive --latest"
  },
  "dependencies": {
